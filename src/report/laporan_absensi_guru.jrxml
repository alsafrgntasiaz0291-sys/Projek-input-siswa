	<parameter name="LOGO_PATH" class="java.lang.String"><defaultValueExpression><![CDATA["src/images/logo (1).png"]]></defaultValueExpression></parameter>
	<queryString language="SQL"><![CDATA[SELECT a.id_absensi, a.tanggal, g.nip, g.nama_guru, a.jam_masuk, a.jam_keluar, a.status, a.keterangan FROM absensi a JOIN guru g ON a.id_guru = g.id_guru ORDER BY a.tanggal DESC, g.nama_guru]]></queryString>
