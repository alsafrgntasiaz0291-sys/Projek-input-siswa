	<parameter name="LOGO_PATH" class="java.lang.String"><defaultValueExpression><![CDATA["src/images/logo (1).png"]]></defaultValueExpression></parameter>
	<queryString language="SQL"><![CDATA[SELECT a.id_absensi, a.tanggal, s.kelas, s.jurusan, s.nis, s.nama, a.jam_masuk, a.jam_keluar, a.status, a.keterangan FROM absensi a JOIN siswa s ON a.id_siswa = s.id ORDER BY a.tanggal DESC, s.nama]]></queryString>
